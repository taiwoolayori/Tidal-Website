{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidalcrestgroup.com/contracts/publication-manifest/0.1.0-draft",
  "title": "Tidal Crest approved public publication manifest (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "releases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "kind",
        "title",
        "summary",
        "revision",
        "status",
        "published_at",
        "rights_cleared",
        "privacy_cleared",
        "facts_verified",
        "authorization_confirmed"
      ],
      "properties": {
        "publication_id": {
          "type": "string",
          "pattern": "^pub_[a-z0-9_-]{4,64}$"
        },
        "kind": {
          "enum": [
            "entity",
            "project-update",
            "farm-journal",
            "media",
            "challenge",
            "foundation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "summary": {
          "type": "string",
          "maxLength": 1500
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "published"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "rights_cleared": {
          "const": true
        },
        "privacy_cleared": {
          "const": true
        },
        "facts_verified": {
          "const": true
        },
        "authorization_confirmed": {
          "const": true
        },
        "public_entity_ref": {
          "type": "string",
          "pattern": "^public_[a-z0-9-]+$"
        },
        "public_project_ref": {
          "type": "string",
          "pattern": "^public_[a-z0-9-]+$"
        },
        "chapter": {
          "enum": [
            "Vision",
            "Design",
            "Challenge",
            "Build",
            "Operations",
            "Lessons"
          ]
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "public_url",
              "alt"
            ],
            "properties": {
              "public_url": {
                "type": "string",
                "format": "uri"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "approved_status_label": {
          "type": "string",
          "maxLength": 100
        }
      }
    }
  }
}
